# ==============================================================================
# API Keys & Configurations
# ==============================================================================

# Google Gemini API Key (Required for AI generation)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key (Optional: for public metadata queries)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Path to OAuth client_secrets.json for direct YouTube uploads
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Directories
LOG_DIR=logs
CACHE_DIR=cache
OUTPUT_DIR=output
